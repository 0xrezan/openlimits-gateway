GATEWAY_ENV=development
GATEWAY_LOG_LEVEL=INFO
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_WORKERS=1
GATEWAY_REQUEST_TIMEOUT_MS=30000
GATEWAY_CONNECT_TIMEOUT_MS=5000
GATEWAY_POOL_TIMEOUT_MS=5000
GATEWAY_MAX_CONNECTIONS=200
GATEWAY_MAX_KEEPALIVE_CONNECTIONS=50
GATEWAY_GLOBAL_CONCURRENCY_LIMIT=500
GATEWAY_MAX_REQUEST_BODY_BYTES=10485760
GATEWAY_METRICS_ENABLED=true
GATEWAY_TRACING_ENABLED=false
GATEWAY_ENABLE_DEBUG_HTTP_LOGS=false
GATEWAY_DEBUG_HTTP_LOG_MAX_REQUEST_BODY_BYTES=8192
GATEWAY_DEBUG_HTTP_LOG_MAX_RESPONSE_BODY_BYTES=8192
GATEWAY_DEBUG_HTTP_LOG_MAX_STREAM_CHUNK_PREVIEWS=3
GATEWAY_ADMIN_API_ENABLED=false
# Generate with: python scripts/hash_admin_token.py
GATEWAY_ADMIN_API_TOKEN_HASH=
GATEWAY_ADMIN_API_BIND=127.0.0.1
GATEWAY_ADMIN_API_IP_ALLOWLIST=127.0.0.1/32
GATEWAY_DATABASE_URL=postgresql+asyncpg://gateway:gateway@127.0.0.1:5432/gateway
GATEWAY_REDIS_URL=redis://127.0.0.1:6379/0
GATEWAY_UPSTREAM_BASE_URL=https://main.internal
GATEWAY_UPSTREAM_SERVICE_TOKEN=
GATEWAY_UPSTREAM_SERVICE_TOKEN_HEADER=Authorization
GATEWAY_UPSTREAM_STREAM_TRANSPORT_MODE=auto
GATEWAY_UPSTREAM_SIGNING_ENABLED=true
# Required when GATEWAY_UPSTREAM_SIGNING_ENABLED=true
GATEWAY_UPSTREAM_SIGNING_KEY=
GATEWAY_UPSTREAM_MTLS_ENABLED=false
GATEWAY_UPSTREAM_CLIENT_CERT=
GATEWAY_UPSTREAM_CLIENT_KEY=
GATEWAY_UPSTREAM_CA_CERT=
GATEWAY_CONFIG_DIR=./config
GATEWAY_ROUTE_CONFIG=./config/routes.yaml
GATEWAY_POLICY_CONFIG=./config/policies.yaml
GATEWAY_LIMIT_CONFIG=./config/limits.yaml
GATEWAY_LOGGING_CONFIG=./config/logging.yaml
GATEWAY_AUDIT_RETENTION_DAYS=30
GATEWAY_USAGE_RETENTION_DAYS=90
GATEWAY_CONFIG_RELOAD_INTERVAL_SECONDS=30
GATEWAY_CONSUMER_CACHE_TTL_SECONDS=60
GATEWAY_ENABLE_REAL_UPSTREAM_HEALTHCHECK=false
