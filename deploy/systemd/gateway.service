[Unit]
Description=OpenLimits VPS Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/openlimits-vps
EnvironmentFile=/opt/openlimits-vps/.env
ExecStart=/opt/openlimits-vps/.venv/bin/uvicorn src.main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
User=gateway
Group=gateway

[Install]
WantedBy=multi-user.target

